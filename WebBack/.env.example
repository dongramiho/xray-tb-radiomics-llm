# Copy to WebBack/.env and fill in. Every variable is optional except OPENAI_API_KEY (when LLM_BACKEND=openai).

# --- LLM ---
OPENAI_API_KEY=sk-...
LLM_BACKEND=openai                 # openai | fake (deterministic stub for tests / offline UI work)
REPORT_MODEL=gpt-4.1               # stage 1: structured clinical report (JSON)
SUMMARY_MODEL=gpt-4.1-mini         # stage 2: clinician-facing Korean summary

# --- models ---
# SEGMENTATION_MODEL_PATH=../model/outputs/checkpoints/best_model.h5
# CLASSIFIER_PATH=../model/outputs/classifier/tb_classifier.joblib
INFERENCE_BACKEND=real             # real | fake (skip TensorFlow; returns a fixed demo result)

# --- service ---
ENVIRONMENT=development
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=sqlite:///./xray_app.db
MAX_UPLOAD_MB=20
