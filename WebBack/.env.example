# Copy to WebBack/.env and fill in. Every variable is optional except OPENAI_API_KEY (when LLM_BACKEND=openai).

# --- LLM ---
OPENAI_API_KEY=sk-...
LLM_BACKEND=openai                 # openai | fake (deterministic stub for tests / offline UI work)
REPORT_MODEL=gpt-4.1               # stage 1: structured clinical report (JSON)
SUMMARY_MODEL=gpt-4.1-mini         # stage 2: clinician-facing Korean summary
REPORT_FALLBACK_MODEL=gpt-4.1-mini # used after retries are exhausted
SUMMARY_FALLBACK_MODEL=gpt-4.1
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=6                        # knowledge-base chunks retrieved per case
JUDGE_MODEL=gpt-4.1-mini           # LLM-as-judge model used by evals/run_evals.py

# --- optional Gemini fallback (deck design: GPT primary, Gemini fallback with low thinking) ---
# GOOGLE_API_KEY=AIza...           # https://aistudio.google.com/apikey
# FALLBACK_PROVIDER=gemini         # openai (default) | gemini
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# GEMINI_THINKING_LEVEL=low

# --- chat graph (LangGraph) ---
# GRAPH_CHECKPOINT_PATH=./graph_checkpoints.sqlite   # SQLite only; PostgreSQL reuses DATABASE_URL
MODERATION_CACHE_THRESHOLD=0.92    # semantic cache for the inappropriate-question picker
SIMILAR_CASES_K=3                  # reference cases retrieved from the evaluation set
PUBMED_ENABLED=true                # literature retrieval via NCBI E-utilities (no key required)
# NCBI_API_KEY=...                 # optional: higher PubMed rate limit  https://www.ncbi.nlm.nih.gov/account/
PUBMED_MAX_RESULTS=3
PUBMED_TIMEOUT_S=6

# --- models ---
# SEGMENTATION_MODEL_PATH=../model/outputs/checkpoints/best_model.h5
# CLASSIFIER_PATH=../model/outputs/classifier/tb_classifier.joblib
INFERENCE_BACKEND=real             # real | fake (skip TensorFlow; returns a fixed demo result)

# --- service ---
ENVIRONMENT=development
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=sqlite:///./xray_app.db
AUTO_MIGRATE=true                  # apply Alembic migrations at startup (Docker entrypoint does it instead)
MAX_UPLOAD_MB=20
MAX_CT_UPLOAD_MB=300               # NIfTI CT volume / mask uploads

# --- auth (clinician accounts are provisioned by the operator; no self sign-up) ---
JWT_SECRET=dev-only-change-me          # production: a random 32+ character string
ACCESS_TOKEN_EXPIRE_MINUTES=720
SEED_DOCTOR_EMAIL=doctor@test.com
SEED_DOCTOR_PASSWORD=changeme          # production refuses to start with this default
SEED_DOCTOR_NAME=Dr. Kim
SEED_HOSPITAL_CODE=default           # hospital unit for the seeded accounts
SEED_HOSPITAL_NAME=Default Hospital
# SEED_ADMIN_EMAIL=admin@test.com    # optional unit administrator (sees all patients in the unit, usage stats)
# SEED_ADMIN_PASSWORD=changeme
FRONTEND_BASE_URL=http://localhost:3000   # used to build patient share links (/share/<token>)
SHARE_LINK_DEFAULT_HOURS=72
SHARE_LINK_MAX_QUESTIONS=5
RATE_LIMIT_SHARE=20/minute

# --- request handling ---
RATE_LIMIT_ANALYZE=30/minute
RATE_LIMIT_ENABLED=true
LOG_JSON=false
